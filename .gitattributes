# ==============================
# Git 换行符统一配置模板
# ==============================

# 所有文本文件自动处理换行符
* text=auto

# 强制所有文本文件提交时转换为 LF
# Windows 上检出时会自动转换为 CRLF（根据 core.autocrlf 配置）
* text eol=lf

# ==============================
# 指定类型文件保持特定换行符
# ==============================

# Windows 批处理文件使用 CRLF
*.bat text eol=crlf

# PowerShell 脚本使用 LF
*.ps1 text eol=lf

# Markdown 文本、配置文件使用 LF
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf

# ==============================
# 二进制文件保持原样，不转换
# ==============================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.exe binary
*.dll binary
*.so binary
*.class binary
*.jar binary
*.apk binary
*.RSA binary
*.DSA binary

# Signature/manifest files
MANIFEST.MF text eol=lf
*.SF text eol=lf