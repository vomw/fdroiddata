Categories:
  - Health Manager
License: MIT
AuthorName: FSchiltz
AuthorWebSite: https://github.com/FSchiltz/Helse
SourceCode: https://github.com/FSchiltz/Helse
IssueTracker: https://github.com/FSchiltz/Helse/issues

AutoName: helse

RepoType: git
Repo: https://github.com/FSchiltz/Helse.git

Builds:
  - versionName: 0.16.6
    versionCode: 161
    commit: d1f82509e720833eda48aa2b2f8dddae6489670f
    subdir: flutter_frontend
    output: build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk
    srclibs:
      - flutter@stable
    rm:
      - flutter_frontend/web
      - flutter_frontend/linux
      - flutter_frontend/ios
    prebuild:
      - flutterVersion=$(sed -n -E "s/.*flutter-version:\ '(.*)'/\1/p" ../.github/workflows/build-android.yml)
      - '[[ $flutterVersion ]]'
      - git -C $$flutter$$ checkout -f $flutterVersion
      - export PUB_CACHE=$(pwd)/.pub-cache
      - $$flutter$$/bin/flutter config --no-analytics
      - $$flutter$$/bin/flutter pub get
    scanignore:
      - flutter_frontend/.pub-cache
    build:
      - export PUB_CACHE=$(pwd)/.pub-cache
      - $$flutter$$/bin/flutter build apk --release --split-per-abi --target-platform=android-arm

  - versionName: 0.16.6
    versionCode: 162
    commit: d1f82509e720833eda48aa2b2f8dddae6489670f
    subdir: flutter_frontend
    output: build/app/outputs/flutter-apk/app-arm64-v8a-release.apk
