index 0000000..bb88e5e
--- /dev/null
+++ b/external/asmack/build/src/trunk/org/jivesoftware/smack/LLPacketReader.java
@@ -0,0 +1,244 @@
+/**
+ * $RCSfile$
+ * $Revision: 7232 $
+ * $Date: 2007-02-20 16:57:31 -0800 (Tue, 20 Feb 2007) $
+ *
+ * Copyright 2003-2007 Jive Software. 2008-2009 Jonas Ådahl
