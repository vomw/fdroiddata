+++ b/external/asmack/build/src/trunk/org/jivesoftware/smackx/packet/AdHocCommandData.java
@@ -0,0 +1,279 @@
+/**
+ * $RCSfile$
+ * $Revision: $
+ * $Date: $
+ *
