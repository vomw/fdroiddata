+
+        new /* Service */Prober(this).start(timer);
+        try
+        {
+            synchronized (info)
+            {
+                while (info.getState().compareTo(DNSState.ANNOUNCED) < 0)
+                {
+                    info.wait();
+                }
+            }
+        }
+        catch (final InterruptedException e)
+        {
+            // empty
+        }
+        logger.fine("registerService() JmDNS registered service as " + info);
