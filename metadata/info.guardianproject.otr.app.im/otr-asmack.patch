diff --git a/external/asmack/build/src/trunk/org/jivesoftware/smackx/pubsub/ItemsExtension.java b/external/asmack/build/src/trunk/org/jivesoftware/smackx/pubsub/ItemsExtension.java
new file mode 100644
index 0000000..c98d93a
--- /dev/null
+++ b/external/asmack/build/src/trunk/org/jivesoftware/smackx/pubsub/ItemsExtension.java
@@ -0,0 +1,196 @@
+/**
