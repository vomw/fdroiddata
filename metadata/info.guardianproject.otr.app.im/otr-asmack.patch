+    /**
+     * Remove a listener from all outstanding questions. The listener will no
+     * longer receive any updates.
+     */
+    public void removeListener(DNSListener listener)
+    {
+        synchronized (this)
+        {
+            listeners.remove(listener);
+        }
+    }
